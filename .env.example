# Server
PORT=3000
NODE_ENV=development

# Downstream service this BFF aggregates (REST, typed client from @demo/contracts)
PAYMENT_SERVICE_URL=http://localhost:3004

# Auth
# AUTH_DISABLED=true skips identity extraction (tests/local dev).
# Signature verification lives in the Envoy PEP, not in the app.
AUTH_DISABLED=false

# Observability — OpenTelemetry
# Leave blank to use ConsoleSpanExporter (prints to stdout) for local dev
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=payment-bff
